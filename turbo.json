{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"install": {},
		"build": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"dependsOn": ["^generate", "^build"],
			"outputs": ["build/**", "dist/**", "node_modules/**"],
			"cache": true
		},
		"generate": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"dependsOn": ["^generate", "^build"],
			"cache": true,
			"persistent": true
		},
		"clean": {
			"cache": false
		},
		"format": {
			"cache": false
		}
	}
}
